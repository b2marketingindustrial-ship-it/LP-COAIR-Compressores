---
/**
 * Header no visual COAIR: faixa translúcida sobre a foto do hero, logo, menu de âncoras e
 * CTA na pílula verde dos outros botões da página, em tamanho `sm`. Fica fixo no topo e
 * escurece ao rolar a página.
 * Logo em src/assets/LOGO.png; os links apontam para os ids das seções da página.
 */
import { Image } from 'astro:assets'
import logo from '../assets/LOGO.png'
import Icon from './Icon.astro'
import Button from './Button.astro'
import { site } from '../data/site'
import { cta, hero } from '../data/content'

const solutions = [
  { label: 'Linhas de compressores', href: '#linhas' },
  { label: 'Dados para a cotação', href: '#identificar' },
  { label: `Por que a ${site.brandShort}`, href: '#aplicacoes' },
]

const links = [
  { label: 'Linhas', href: '#linhas' },
  { label: 'Institucional', href: '#aplicacoes' },
  { label: `Sobre a ${site.brandShort}`, href: '#diferenciais' },
]
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-[rgb(0_27_45/0.78)] transition-[background-color,box-shadow] duration-300 data-scrolled:bg-primary-dark-900/95 data-scrolled:shadow-[0_12px_30px_-18px_rgba(0,0,0,0.8)] data-scrolled:backdrop-blur-md"
>
  <div class="mx-auto flex h-(--header-h) max-w-page items-center justify-between gap-6 px-6 lg:px-10">
    {/* 1. Logo */}
    <a href="/" class="flex shrink-0 items-center">
      <Image
        src={logo}
        alt={site.brand}
        width={276}
        height={92}
        format="webp"
        loading="eager"
        decoding="async"
        class="h-9 w-auto lg:h-[46px]"
      />
    </a>

    {/* 2. Menu (some no mobile) */}
    <nav aria-label="Principal" class="mr-auto ml-11 hidden lg:block">
      <ul class="flex items-center gap-10 font-sans text-[15px] font-medium text-neutral-light">
        <li class="group relative">
          <a
            href="#linhas"
            class="flex items-center gap-2 py-2 transition-colors hover:text-brand-green"
            aria-haspopup="true"
          >
            Soluções
            <Icon
              name="chevron-down"
              class="size-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
            />
          </a>
          <ul class="invisible absolute top-full left-0 min-w-56 translate-y-1 rounded-lg border border-white/10 bg-primary-dark-900/95 p-2 opacity-0 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.7)] backdrop-blur-md transition-all group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
            {solutions.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-md px-3 py-2 text-sm whitespace-nowrap transition-colors hover:bg-white/5 hover:text-brand-green"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
        {links.map((item) => (
          <li>
            <a href={item.href} class="py-2 transition-colors hover:text-brand-green">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* 3. CTA na pílula verde (13/10/2026, no lugar do botão laranja). Rótulo curto no
        mobile, onde o completo não cabe ao lado da logo. */}
    <Button cta="header-cta" variant="brand" size="sm" class="shrink-0">
      <span class="sm:hidden">{cta.primaryShort}</span>
      <span class="hidden sm:inline">{hero.ctaPrimary}</span>
    </Button>
  </div>
</header>

<script>
  // Escurece o header assim que a página sai do topo (sobre o hero ele fica translúcido).
  const header = document.querySelector<HTMLElement>('[data-header]')
  const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8)
  update()
  window.addEventListener('scroll', update, { passive: true })
</script>
