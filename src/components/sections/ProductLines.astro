---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * Cabeçalho à esquerda, grid de 3–4 cards com um card escuro. Fundo e respiro vêm
 * da composição via `tone`/`rhythm`.
 *
 * Visual COAIR: sem carrossel de marcas (a oferta é de linha própria), marcador e
 * acentos verdes, foto em cena preenchendo o palco do card.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import SectionHeader from '@components/SectionHeader.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines = productLines.items
const tech = productLines.technology

// Curva do gráfico VSD: a mesma geometria serve ao traço, à área sob ele e ao pulso.
const vsdCurve =
  'M30 225 C 75 160, 120 150, 150 160 S 210 140, 250 100 S 320 20, 350 50 S 400 270, 450 280 S 500 220, 515 190 S 520 172, 535 172'
---

{/* COAIR: respiro único entre seções (global.css) no lugar do ritmo da composição. O vão
    até o painel do identificar fica metade aqui, metade lá. */}
<Section
  id="linhas"
  tone={tone}
  rhythm={rhythm}
  class="pt-(--section-gap)! pb-[calc(var(--section-gap)/2)]!"
>
  <SectionHeader
    eyebrow={productLines.eyebrow}
    title={productLines.title}
    text={productLines.text}
    width="full"
    accent="green"
    shape="dash"
  />

  <div
    class:list={[
      'mt-10 grid gap-5 sm:grid-cols-2',
      lines.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
    ]}
  >
    {lines.map((line, i) => (
      <article
        class:list={[
          'product-card group relative flex flex-col overflow-hidden rounded-2xl border transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5',
          line.dark
            ? 'navy-premium border-white/10 shadow-[0_18px_40px_-24px_rgba(0,24,48,0.6)] hover:border-brand-green/60 hover:shadow-[0_28px_56px_-24px_rgba(0,24,48,0.75)]'
            : 'border-neutral-gray-200/70 bg-neutral-light shadow-[0_1px_2px_rgba(13,29,48,0.05)] hover:border-brand-green/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]',
        ]}
      >
        {/* Linha de acento no topo — cresce no hover */}
        <span
          aria-hidden="true"
          class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-brand-green transition-transform duration-300 ease-out group-hover:scale-x-100"
        />

        {/* Palco da imagem */}
        <div
          class:list={[
            'relative h-60 overflow-hidden bg-neutral-light',
            line.dark && 'border-b border-white/12',
          ]}
        >
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-contain object-center px-6 pt-10 pb-3 mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />

          <span class="absolute top-4 left-4 z-[2] font-display text-[11px] font-extrabold tracking-[0.2em] text-primary-dark/40">
            {String(i + 1).padStart(2, '0')}
          </span>

          <span class="absolute top-3.5 right-4 z-[2] rounded-full border border-primary-dark/10 bg-neutral-light px-2.5 py-1 font-sans text-[10px] font-bold tracking-[0.16em] text-primary-dark/75 uppercase">
            {line.tag}
          </span>
        </div>

        {/* Conteúdo */}
        <div class="flex flex-1 flex-col px-6 pt-5 pb-4">
          <h3
            class:list={[
              'font-display text-lg leading-snug font-extrabold',
              line.dark ? 'text-neutral-light' : 'text-ink',
            ]}
          >
            {line.title}
          </h3>

          <p
            class:list={[
              'mt-2 font-sans text-[13px] leading-relaxed',
              line.dark ? 'text-neutral-light/65' : 'text-ink-soft',
            ]}
          >
            {line.description}
          </p>

          <ul class="mt-4 mb-4 flex flex-col gap-2">
            {line.features.map((feature) => (
              <li
                class:list={[
                  'flex items-center gap-2.5 font-sans text-[13px] font-medium',
                  line.dark ? 'text-neutral-light/90' : 'text-ink',
                ]}
              >
                <span
                  class:list={[
                    'flex size-5 shrink-0 items-center justify-center rounded-full',
                    line.dark
                      ? 'bg-brand-green/20 text-brand-green'
                      : 'bg-brand-green/12 text-brand-green-deep',
                  ]}
                >
                  <Icon name="check" class="size-3" />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <button
            type="button"
            data-cta={`linhas-${line.id}`}
            class:list={[
              'btn-slave-whats mt-auto flex items-center justify-between gap-3 border-t pt-3 font-sans text-[13px] font-bold transition-colors duration-200',
              line.dark
                ? 'border-white/10 text-neutral-light hover:text-brand-green'
                : 'border-neutral-gray-200/60 text-primary-dark hover:text-brand-green-deep',
            ]}
          >
            <span>{cta.card}</span>
            <span
              class:list={[
                'flex size-8 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-brand-green group-hover:text-neutral-light',
                line.dark
                  ? 'bg-white/10 text-neutral-light'
                  : 'bg-brand-green/12 text-brand-green-deep',
              ]}
            >
              <Icon name="arrow-right" class="size-3.5" />
            </span>
          </button>
        </div>
      </article>
    ))}
  </div>

  {/* Módulo de tecnologia VSD, logo abaixo dos modelos */}
  <div class="vsd-panel relative mt-12 overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-gray-100 lg:mt-14">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -right-6 -bottom-16 font-display text-[220px] leading-none font-extrabold text-primary-dark/[0.04] select-none lg:text-[300px]"
    >
      VSD
    </span>

    <div class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-center lg:gap-12 lg:p-12">
      <div>
        <Eyebrow accent="green" shape="dash">
          {tech.eyebrow}
        </Eyebrow>
        <h3 class="mt-3 font-display text-2xl leading-tight font-extrabold text-ink lg:text-[28px]">
          {tech.title}
        </h3>
        <p class="mt-4 font-sans text-[15px] leading-relaxed text-ink-soft">{tech.text}</p>
        <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft">{tech.note}</p>

        <ul class="mt-5 flex flex-col gap-2.5">
          {tech.points.map((point) => (
            <li class="flex items-center gap-2.5 font-sans text-[14px] font-medium text-ink">
              <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-green/12 text-brand-green-deep">
                <Icon name="check" class="size-3" />
              </span>
              {point}
            </li>
          ))}
        </ul>

        <Button cta="linhas-tecnologia-vsd" variant="brand" class="mt-7 w-full sm:w-auto">
          {cta.primary}
        </Button>
      </div>

      {/* Curva ilustrativa do uso do motor acompanhando a demanda (sem escala nem números).
          Animada ao entrar na tela: a curva se desenha, os pontos surgem e um pulso de luz a
          percorre em loop (o motor acompanhando a demanda). Sem JS ou com movimento
          reduzido, fica estática e já desenhada. */}
      <figure class="vsd-chart m-0" data-vsd-chart>
        <svg
          viewBox="0 0 560 300"
          role="img"
          aria-label="Curva ilustrativa da potência do motor acompanhando a variação da demanda de ar"
          class="h-auto w-full overflow-visible"
        >
          <defs>
            <linearGradient id="vsd-area-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--color-brand-green)" stop-opacity="0.16"></stop>
              <stop offset="100%" stop-color="var(--color-brand-green)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <g stroke="currentColor" stroke-dasharray="6 7" class="vsd-grid text-primary-dark/20">
            <line x1="0" y1="20" x2="560" y2="20"></line>
            <line x1="0" y1="95" x2="560" y2="95"></line>
            <line x1="0" y1="170" x2="560" y2="170"></line>
            <line x1="0" y1="245" x2="560" y2="245"></line>
          </g>
          <path
            class="vsd-area"
            d={`${vsdCurve} L535 300 L30 300 Z`}
            fill="url(#vsd-area-fill)"
          ></path>
          <path
            class="vsd-line"
            d={vsdCurve}
            pathLength="1"
            fill="none"
            stroke="var(--color-brand-green-deep)"
            stroke-width="3.5"
            stroke-linecap="round"
          ></path>
          <path
            class="vsd-pulse"
            d={vsdCurve}
            pathLength="1"
            fill="none"
            stroke="var(--color-brand-green)"
            stroke-width="6"
            stroke-linecap="round"
          ></path>
          <g class="vsd-dot vsd-dot-start">
            <circle
              class="vsd-halo"
              cx="30"
              cy="225"
              r="20"
              fill="var(--color-brand-green)"
              opacity="0.22"
            ></circle>
            <circle cx="30" cy="225" r="7" fill="var(--color-brand-green-deep)"></circle>
          </g>
          <g class="vsd-dot vsd-dot-end">
            <circle
              class="vsd-halo"
              cx="535"
              cy="172"
              r="20"
              fill="var(--color-primary-dark)"
              opacity="0.18"
            ></circle>
            <circle cx="535" cy="172" r="7" fill="var(--color-primary-dark)"></circle>
          </g>
        </svg>
        <figcaption class="mt-3 font-sans text-[13px] font-semibold text-ink-soft">
          {tech.chartLabel}
        </figcaption>
      </figure>
    </div>
  </div>
</Section>

<style>
  /* Canto técnico discreto que aparece no hover */
  .product-card::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 14px;
    height: 14px;
    border-right: 2px solid var(--color-brand-green);
    border-bottom: 2px solid var(--color-brand-green);
    opacity: 0;
    transform: translate(4px, 4px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
    pointer-events: none;
  }

  .product-card:hover::after {
    opacity: 0.9;
    transform: translate(0, 0);
  }

  /* Gráfico VSD -------------------------------------------------------------
     O pulso só aparece animado. O estado inicial (curva por desenhar, pontos recolhidos)
     só vale com `data-animate`, que o script põe quando há JS e movimento liberado.
     Pulso: trecho de 7% da curva com um vão maior que ela, para entre uma volta e outra
     ele sumir por um instante em vez de emendar. Começa e termina fora da curva. */
  .vsd-pulse {
    opacity: 0;
    stroke-dasharray: 0.07 1.5;
    stroke-dashoffset: 0.08;
    filter: drop-shadow(0 0 5px rgb(63 220 90 / 0.9));
  }

  .vsd-dot,
  .vsd-halo {
    transform-box: fill-box;
    transform-origin: center;
  }

  .vsd-chart[data-animate] .vsd-grid,
  .vsd-chart[data-animate] .vsd-area {
    opacity: 0;
  }
  .vsd-chart[data-animate] .vsd-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .vsd-chart[data-animate] .vsd-dot {
    transform: scale(0);
  }

  /* 1. grade e ponto inicial · 2. a curva se desenha · 3. área e ponto final ·
     4. pulso percorrendo a curva e halos respirando, em loop */
  .vsd-chart.is-visible .vsd-grid {
    animation: vsd-fade 0.5s ease-out forwards;
  }
  .vsd-chart.is-visible .vsd-dot-start {
    animation: vsd-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s forwards;
  }
  .vsd-chart.is-visible .vsd-line {
    animation: vsd-draw 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards;
  }
  .vsd-chart.is-visible .vsd-area {
    animation: vsd-fade 0.8s ease-out 1.6s forwards;
  }
  .vsd-chart.is-visible .vsd-dot-end {
    animation: vsd-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 2s forwards;
  }
  .vsd-chart.is-visible .vsd-pulse {
    opacity: 1;
    animation: vsd-run 3.2s linear 2.5s infinite;
  }
  .vsd-chart.is-visible .vsd-dot-start .vsd-halo {
    animation: vsd-breathe 2.8s ease-in-out 2.5s infinite;
  }
  .vsd-chart.is-visible .vsd-dot-end .vsd-halo {
    animation: vsd-breathe 2.8s ease-in-out 3.9s infinite;
  }

  @keyframes vsd-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes vsd-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes vsd-pop {
    to {
      transform: scale(1);
    }
  }
  /* Uma volta = dash + vão (1.57): o estado final repete o inicial e o loop não salta. */
  @keyframes vsd-run {
    to {
      stroke-dashoffset: -1.49;
    }
  }
  @keyframes vsd-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card img,
    .product-card span {
      transition: none !important;
    }
    .product-card:hover {
      transform: none;
    }
  }
</style>

<script>
  // Gráfico VSD: anima uma vez, quando entra na tela. Sem IntersectionObserver ou com
  // movimento reduzido, não arma nada e o gráfico fica estático, já desenhado.
  const chart = document.querySelector<HTMLElement>('[data-vsd-chart]')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (chart && !reduce && 'IntersectionObserver' in window) {
    chart.toggleAttribute('data-animate', true)
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        chart.classList.add('is-visible')
        observer.disconnect()
      },
      { threshold: 0.4 },
    )
    observer.observe(chart)
  }
</script>
