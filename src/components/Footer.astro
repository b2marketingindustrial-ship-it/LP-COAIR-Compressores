---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.5), no visual COAIR: além da linha de copyright e do
 * crédito da B2, o rodapé traz a logo, a frase da marca, os contatos e o CTA de cotação, como
 * no layout de referência do cliente — numa faixa só, com contatos, botão e ícones em linha.
 */
import { Image } from 'astro:assets'
import logo from '../assets/LOGO.png'
import Icon from './Icon.astro'
import Button from './Button.astro'
import { site, whatsapp } from '../data/site'
import { footer } from '../data/content'

const year = new Date().getFullYear()

const socialClass =
  'flex size-9 items-center justify-center rounded-full border border-[#508cdc]/55 text-neutral-light transition-colors duration-200 hover:border-brand-green hover:text-brand-green'
---

{/* Cantos retos, como os blocos navy da página */}
<footer class="navy-premium border-t border-white/15">
  <div class="relative overflow-hidden">
    {/* Linha verde no topo, com um trecho laranja à direita */}
    <span aria-hidden="true" class="footer-line absolute inset-x-0 top-0 h-1"></span>

    {/* Malha de pontos em onda e desenho técnico apagados, à direita */}
    <svg
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-[42%] [mask-image:linear-gradient(to_right,transparent,black_45%)] lg:block"
      viewBox="0 0 560 220"
      preserveAspectRatio="xMaxYMid slice"
      fill="none"
    >
      <g
        stroke="#3b82e0"
        stroke-opacity="0.45"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-dasharray="0.1 6"
      >
        {Array.from({ length: 12 }, (_, i) => (
          <path d={`M0 ${150 + i * 5}C140 ${120 + i * 9} 260 ${20 + i * 12} 560 ${30 + i * 8}`} />
        ))}
      </g>
      <g
        stroke="#3b82e0"
        stroke-opacity="0.4"
        stroke-width="1.6"
        stroke-linejoin="round"
        transform="translate(390 30) scale(0.42)"
      >
        <path d="M60 110 90 80h290l-30 30"></path>
        <rect x="60" y="110" width="290" height="160" rx="4"></rect>
        <path d="M350 110 380 80v160l-30 30"></path>
        <path d="M155 110v160M255 110v160"></path>
        <rect x="175" y="135" width="44" height="32" rx="3"></rect>
        <path d="M60 270v12h290v-12"></path>
        <rect x="420" y="40" width="64" height="242" rx="32"></rect>
        <path d="M380 140h40M380 220h22v40h18"></path>
      </g>
    </svg>

    <div class="relative mx-auto max-w-page px-6 lg:px-10">
      <div class="flex flex-col gap-5 pt-8 pb-6 xl:flex-row xl:items-center xl:justify-between xl:gap-8">
        {/* Marca */}
        <div class="flex items-center gap-4">
          <Image
            src={logo}
            alt={site.brand}
            width={240}
            height={80}
            format="webp"
            loading="lazy"
            decoding="async"
            class="h-9 w-auto shrink-0 lg:h-10"
          />
          <span aria-hidden="true" class="footer-divider h-10 w-px shrink-0"></span>
          <p class="max-w-[16rem] font-sans text-[13px] leading-snug text-balance text-neutral-light/75">
            {footer.tagline}
          </p>
        </div>

        {/* Atendimento e cotação, em linha */}
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <address
            aria-label={footer.contactLabel}
            class="flex flex-wrap items-center gap-x-5 gap-y-2 not-italic"
          >
            <a
              href={`mailto:${site.email}`}
              class="flex items-center gap-2 font-sans text-sm text-neutral-light transition-colors hover:text-brand-green"
            >
              <Icon name="mail" class="size-4 shrink-0 text-brand-green" />
              {site.email}
            </a>
            <span class="flex items-center gap-2 font-sans text-sm text-neutral-light">
              <Icon name="map-pin" class="size-4 shrink-0 text-brand-green" />
              {site.city}
            </span>
          </address>

          <span aria-hidden="true" class="footer-divider hidden h-8 w-px sm:block"></span>

          <div class="flex items-center gap-2.5">
            <Button cta="footer-cta" variant="brand" class="mr-1.5">
              {footer.quoteButton}
            </Button>
            {whatsapp && (
              <a
                href={`https://wa.me/${whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                data-cta="footer-whatsapp"
                aria-label="Conversar pelo WhatsApp"
                class={socialClass}
              >
                <Icon name="whatsapp" class="size-4" />
              </a>
            )}
            {/* Sem WhatsApp: espaço vazio do tamanho do ícone, no mesmo lugar */}
            {!whatsapp && <span aria-hidden="true" class="block size-9 shrink-0"></span>}
            {site.linkedin && (
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${site.brandShort} no LinkedIn`}
                class={socialClass}
              >
                <Icon name="linkedin" class="size-4" />
              </a>
            )}
            <a
              href={`mailto:${site.email}`}
              aria-label={`Enviar e-mail para ${site.email}`}
              class={socialClass}
            >
              <Icon name="mail" class="size-4" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center gap-1.5 border-t border-white/10 py-4 text-center sm:flex-row sm:justify-between sm:text-left">
        <p class="font-sans text-[12px] text-neutral-light/60">
          © {year} {site.brand}. Todos os direitos reservados.
        </p>
        <p class="font-sans text-[12px] text-neutral-light/60">
          Desenvolvido por{' '}
          <a
            href={footer.credit.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-neutral-light/90 transition-colors hover:text-brand-green"
          >
            {footer.credit.label}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-line {
    background: linear-gradient(
      90deg,
      var(--color-brand-green) 0 81%,
      var(--color-accent-orange) 81% 85%,
      var(--color-brand-green) 85%
    );
  }

  .footer-divider {
    background: linear-gradient(to bottom, transparent, rgb(80 140 220 / 0.45), transparent);
  }
</style>
